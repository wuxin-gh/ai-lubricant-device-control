<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: the device dials the server over WebSocket. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service: keeps the WS connection alive while the screen is off
         (Doze would otherwise freeze the process and stall heartbeats → 4010).
         specialUse is the Android 14+ type for "none of the concrete types fit";
         the PROPERTY below states what this specific FGS is for. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The persistent "being remotely controlled" notification needs POST_NOTIFICATIONS
         on Android 13+. Denied only degrades the notification, not the connection. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- list_apps enumerates installed launchables via PackageManager. On Android 11+
         this is the broad-query permission; without it only the handful of packages
         visible to the app via intent-filters are returned. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".ControlApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceControl">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The accessibility service lives in core/ (vendored from ARC-MCP), so the
             manifest must name it by its fully-qualified class. The system binds it
             with the BIND_ACCESSIBILITY_SERVICE permission. -->
        <service
            android:name="dev.devicecontrol.core.accessibility.DeviceControlAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The persistent connection runs as a foreground service so it survives
             screen-off and Doze. specialUse + the subtype property is the Android 14
             requirement; the subtype text explains the purpose to reviewers/users. -->
        <service
            android:name=".ControlForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_subtype" />
            <intent-filter>
                <action android:name="dev.devicecontrol.action.PAIR" />
                <action android:name="dev.devicecontrol.action.UNPAIR" />
                <action android:name="dev.devicecontrol.action.DISCONNECT" />
            </intent-filter>
        </service>
    </application>
</manifest>
